# --- Beget API server: пример переменных окружения ---
# Скопировать в server/.env и заполнить РЕАЛЬНЫМИ значениями.
# server/.env должен быть в .gitignore (никогда не коммитить).

# Порт, на котором поднимется Express
PORT=3000

# Внешний URL фронта — используется как fallback для return_url в YooKassa
# (если в запросе нет Origin) и для CORS allow-list.
APP_URL=https://ai-fotosessia.ru
ALLOWED_ORIGINS=https://ai-fotosessia.ru,http://localhost:5173

# Beget Postgres connection string.
# Формат: postgres://USER:PASSWORD@HOST:5432/DB_NAME
# Для Beget cloud: postgres://cloud_user:PASSWORD@gopincekenem.beget.app:5432/default_db
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB

# YooKassa: shopId — только цифры, secret — строка вида live_xxx или test_xxx
# БЕРЁМ В ЛИЧНОМ КАБИНЕТЕ ЮKassa → раздел "Интеграция → API ключи".
# 1298395 — это ваш shopId.
YOOKASSA_SHOP_ID=1298395
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

NODE_ENV=production
