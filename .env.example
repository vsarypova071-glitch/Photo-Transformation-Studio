# .env.example — шаблон для локальной разработки и деплоя на Beget VPS
# Скопируй в .env и заполни реальными значениями.
# .env никогда не коммитится (в .gitignore).

# === Frontend (Vite — переменные VITE_* попадают в browser bundle) ===
VITE_API_URL=https://ai-fotosessia.ru
VITE_ENABLE_REFERRALS=false

# === Backend (НЕ попадают в browser) ===
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=live_...
YOOKASSA_WEBHOOK_USER=webhook
YOOKASSA_WEBHOOK_PASS=securepassword
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Секрет для подписи временных ссылок на фото (/api/photos/signed/:token),
# которые передаются в OpenRouter/AI Gateway вместо base64. Срок жизни ссылки — 10 мин.
# Генерировать так: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHOTO_LINK_SIGNING_SECRET=
# --- AI Gateway (опционально) ---
# Если AI_GATEWAY_URL задан — server/services/openrouter.ts шлёт запросы туда
# вместо openrouter.ai, авторизуясь AI_GATEWAY_TOKEN (это токен Gateway для
# проекта ai-fotosessia, НЕ реальный ключ OpenRouter — тот хранится только на
# самом Gateway). Если AI_GATEWAY_URL не задан — поведение как раньше, без изменений
# (прямой OpenRouter, OPENROUTER_API_KEY выше).
# AI_GATEWAY_URL=https://5-129-232-49.sslip.io/v1/chat/completions
# AI_GATEWAY_TOKEN=
# Необязательно: переопределить клиентский таймаут одного вызова ИИ (мс).
# По умолчанию 90000 в direct-режиме, 130000 в gateway-режиме (у Gateway свой
# upstream-таймаут 120с для ai-fotosessia — наш клиент не должен отваливаться раньше).
# AI_CALL_TIMEOUT_MS=
VITE_DB_HOST=your-db-host.beget.app
VITE_DB_PORT=5432
VITE_DB_NAME=default_db
VITE_DB_USER=cloud_user
VITE_DB_PASSWORD=your_password
APP_URL=https://ai-fotosessia.ru
ALLOWED_ORIGINS=https://ai-fotosessia.ru,https://www.ai-fotosessia.ru,http://localhost:5173
