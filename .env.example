# Vite frontend env. Скопировать в .env и заполнить значениями.
# .env должен быть в .gitignore.

# === Beget backend ===
# URL Beget API. Если фронт и API на одном домене — оставить пустым,
# запросы пойдут относительными путями ('/api/...').
VITE_API_URL=https://ai-fotosessia.ru

# === Supabase (legacy: пока для Storage/Auth, генерация в Phase 2 уйдёт на Beget) ===
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=xxxx

# !!! ВНИМАНИЕ !!!
# DB-креды ДОЛЖНЫ ОСТАВАТЬСЯ ТОЛЬКО НА СЕРВЕРЕ (server/.env).
# В этом файле НЕ должно быть VITE_DB_*, VITE_*_SECRET, OPENROUTER_API_KEY.
# Vite экспортирует все VITE_-переменные в client bundle — они попадут в браузер.
